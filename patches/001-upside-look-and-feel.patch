@@ -101,3 +101,70 @@
   --palette-chartQual8: #efda97;
   --palette-chartQual9: #df948a;
 }
+
+/* ---------------------------------------------------------------------
+ * Upside: Apple-style neutrals, money-green accent and the system font.
+ * Later declarations in :root win, so these remap the palette above.
+ * ------------------------------------------------------------------- */
+:root {
+  --font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text',
+    'Helvetica Neue', system-ui, sans-serif;
+
+  /* navy -> iOS system grays (light to dark) */
+  --palette-navy50: #f9f9fb;
+  --palette-navy100: #f2f2f7;
+  --palette-navy150: #e5e5ea;
+  --palette-navy200: #d1d1d6;
+  --palette-navy300: #c7c7cc;
+  --palette-navy400: #aeaeb2;
+  --palette-navy500: #8e8e93;
+  --palette-navy600: #636366;
+  --palette-navy700: #48484a;
+  --palette-navy800: #2c2c2e;
+  --palette-navy900: #1c1c1e;
+
+  /* gray -> neutral, ending in true black */
+  --palette-gray50: #f9f9fb;
+  --palette-gray80: #f5f5f7;
+  --palette-gray100: #f2f2f7;
+  --palette-gray150: #e5e5ea;
+  --palette-gray200: #d1d1d6;
+  --palette-gray300: #aeaeb2;
+  --palette-gray400: #8e8e93;
+  --palette-gray500: #636366;
+  --palette-gray600: #3a3a3c;
+  --palette-gray700: #2c2c2e;
+  --palette-gray800: #1c1c1e;
+  --palette-gray900: #000000;
+
+  /* purple (the old accent) -> money green */
+  --palette-purple50: #f0fdf4;
+  --palette-purple100: #dcfce7;
+  --palette-purple125: #cdf8dc;
+  --palette-purple150: #bbf7d0;
+  --palette-purple200: #86efac;
+  --palette-purple300: #4ade80;
+  --palette-purple400: #16a34a;
+  --palette-purple500: #15803d;
+  --palette-purple600: #166534;
+  --palette-purple700: #14532d;
+  --palette-purple800: #0f3d22;
+  --palette-purple900: #052e16;
+
+  /* green (positive numbers, notices) -> the same family */
+  --palette-green50: #f0fdf4;
+  --palette-green100: #dcfce7;
+  --palette-green150: #bbf7d0;
+  --palette-green200: #86efac;
+  --palette-green300: #4ade80;
+  --palette-green400: #22c55e;
+  --palette-green500: #16a34a;
+  --palette-green600: #15803d;
+  --palette-green700: #15803d;
+  --palette-green800: #14532d;
+  --palette-green900: #052e16;
+
+  --palette-hover: #f2f2f7;
+  --palette-border: #e5e5ea;
+  --palette-selected: #dcfce7;
+}
