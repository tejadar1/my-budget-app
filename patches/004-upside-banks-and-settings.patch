diff --git a/packages/desktop-client/src/components/mobile/upside/BankConnectionCard.tsx b/packages/desktop-client/src/components/mobile/upside/BankConnectionCard.tsx
new file mode 100644
index 0000000..dd55011
--- /dev/null
+++ b/packages/desktop-client/src/components/mobile/upside/BankConnectionCard.tsx
@@ -0,0 +1,265 @@
+import type { ReactNode } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Link } from 'react-router';
+
+import { theme } from '@actual-app/components/theme';
+
+import type { useBankConnection } from './useBankConnection';
+
+type Bank = ReturnType<typeof useBankConnection>;
+
+// The Accounts tab's bank connection card. Connecting is: open SimpleFIN,
+// link your banks there, paste one token here. Everything after that
+// (adding accounts, syncing) happens on its own.
+
+export function BankConnectionCard({ bank }: { bank: Bank }) {
+  const { t } = useTranslation();
+
+  if (bank.state === 'loading') {
+    return null;
+  }
+
+  if (bank.state === 'needs-server') {
+    return (
+      <Card
+        title={t('Turn on bank sync')}
+        body={t(
+          'Bank sync runs through your Upside server. Connect the app to your server first, then come back here.',
+        )}
+      >
+        <Link to="/settings" style={linkButtonStyle(true)}>
+          {t('Open Settings')}
+        </Link>
+      </Card>
+    );
+  }
+
+  if (bank.state === 'needs-token') {
+    return (
+      <Card
+        title={t('Connect your banks')}
+        body={t(
+          'Upside uses SimpleFIN to read your banks and cards. Both of you can link your banks there; one connection covers everything.',
+        )}
+      >
+        <Step number={1} text={t('Link your banks at SimpleFIN, then copy a setup token.')}>
+          <button type="button" onClick={bank.openSimpleFin} style={buttonStyle(false)}>
+            {t('Open SimpleFIN')}
+          </button>
+        </Step>
+        <Step number={2} text={t('Paste the token. Every account is added for you.')}>
+          <button type="button" onClick={bank.connect} style={buttonStyle(true)}>
+            {t('Paste setup token')}
+          </button>
+        </Step>
+      </Card>
+    );
+  }
+
+  // Connected.
+  if (bank.isAdding) {
+    return <Card title={t('Adding your accounts…')} body={t('This takes a few seconds per bank.')} />;
+  }
+  if (bank.error) {
+    return (
+      <Card title={t('Couldn’t reach your banks')} body={bank.error}>
+        <button type="button" onClick={bank.addAllNew} style={buttonStyle(true)}>
+          {t('Try again')}
+        </button>
+      </Card>
+    );
+  }
+  if (bank.newAccounts.length > 0) {
+    return (
+      <Card
+        title={
+          bank.newAccounts.length === 1
+            ? t('1 new account at your banks')
+            : t('{{count}} new accounts at your banks', {
+                count: bank.newAccounts.length,
+              })
+        }
+        body={bank.newAccounts
+          .map(a => `${a.institution} · ${a.name}`)
+          .join('\n')}
+      >
+        <button type="button" onClick={bank.addAllNew} style={buttonStyle(true)}>
+          {t('Add to Upside')}
+        </button>
+      </Card>
+    );
+  }
+  if (bank.lastAdded != null && bank.lastAdded > 0) {
+    return (
+      <Card
+        title={
+          bank.lastAdded === 1
+            ? t('Added 1 account')
+            : t('Added {{count}} accounts', { count: bank.lastAdded })
+        }
+        body={t('Transactions are downloading now. Tell Upside whose each account is below.')}
+      />
+    );
+  }
+  return null;
+}
+
+/** The quiet row under the account list: sync, link more, add manually. */
+export function BankFooter({ bank }: { bank: Bank }) {
+  const { t } = useTranslation();
+  return (
+    <div
+      style={{
+        display: 'flex',
+        flexDirection: 'column',
+        alignItems: 'center',
+        gap: 4,
+      }}
+    >
+      {bank.state === 'connected' && (
+        <div style={{ display: 'flex', gap: 10 }}>
+          <button
+            type="button"
+            onClick={() => void bank.syncNow()}
+            disabled={bank.isSyncing}
+            style={pillStyle}
+          >
+            {bank.isSyncing ? t('Syncing…') : t('Sync now')}
+          </button>
+          <button type="button" onClick={bank.openSimpleFin} style={pillStyle}>
+            {t('Link another bank')}
+          </button>
+        </div>
+      )}
+      <button
+        type="button"
+        onClick={bank.addManually}
+        style={{
+          all: 'unset',
+          minHeight: 44,
+          display: 'flex',
+          alignItems: 'center',
+          fontSize: 13,
+          color: theme.pageTextSubdued,
+          cursor: 'pointer',
+        }}
+      >
+        {t('Add an account without a bank connection')}
+      </button>
+    </div>
+  );
+}
+
+function Card({
+  title,
+  body,
+  children,
+}: {
+  title: string;
+  body: string;
+  children?: ReactNode;
+}) {
+  return (
+    <section
+      aria-label={title}
+      style={{
+        borderRadius: 18,
+        background: theme.cardBackground,
+        padding: 18,
+        display: 'flex',
+        flexDirection: 'column',
+        gap: 14,
+      }}
+    >
+      <div style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
+        <span style={{ fontSize: 20, fontWeight: 800, color: theme.pageText }}>
+          {title}
+        </span>
+        <span
+          style={{
+            fontSize: 14,
+            color: theme.pageTextSubdued,
+            whiteSpace: 'pre-line',
+          }}
+        >
+          {body}
+        </span>
+      </div>
+      {children}
+    </section>
+  );
+}
+
+function Step({
+  number,
+  text,
+  children,
+}: {
+  number: number;
+  text: string;
+  children: ReactNode;
+}) {
+  return (
+    <div style={{ display: 'flex', gap: 12, alignItems: 'flex-start' }}>
+      <span
+        aria-hidden="true"
+        style={{
+          width: 26,
+          height: 26,
+          flexShrink: 0,
+          borderRadius: 13,
+          background: theme.pageTextPositive,
+          color: theme.cardBackground,
+          display: 'flex',
+          alignItems: 'center',
+          justifyContent: 'center',
+          fontSize: 14,
+          fontWeight: 800,
+          marginTop: 2,
+        }}
+      >
+        {number}
+      </span>
+      <div style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 8 }}>
+        <span style={{ fontSize: 15, color: theme.pageText }}>{text}</span>
+        {children}
+      </div>
+    </div>
+  );
+}
+
+function buttonStyle(primary: boolean) {
+  return {
+    all: 'unset',
+    boxSizing: 'border-box',
+    minHeight: 44,
+    padding: '0 18px',
+    borderRadius: 12,
+    display: 'flex',
+    alignItems: 'center',
+    justifyContent: 'center',
+    fontSize: 16,
+    fontWeight: 700,
+    cursor: 'pointer',
+    background: primary ? theme.buttonPrimaryBackground : theme.tableBorder,
+    color: primary ? theme.buttonPrimaryText : theme.pageText,
+  } as const;
+}
+
+function linkButtonStyle(primary: boolean) {
+  return { ...buttonStyle(primary), textDecoration: 'none' };
+}
+
+const pillStyle = {
+  all: 'unset',
+  minHeight: 40,
+  padding: '0 16px',
+  borderRadius: 20,
+  border: `1px solid ${theme.tableBorder}`,
+  color: theme.pageTextPositive,
+  fontSize: 15,
+  fontWeight: 600,
+  display: 'flex',
+  alignItems: 'center',
+  cursor: 'pointer',
+} as const;
