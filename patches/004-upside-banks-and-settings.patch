+import { useQuery } from '@tanstack/react-query';
+
+import * as monthUtils from '@actual-app/core/shared/months';
+import { q } from '@actual-app/core/shared/query';
+
+import { aqlQuery } from '#queries/aqlQuery';
+
+// How much goes to each category: this month, and the average of the
+// previous few months. Used to pick the categories worth showing first.
+
+export type CategoryActivity = {
+  thisMonth: number;
+  average: number;
+  /** Ranking score: whichever is bigger, so a new expense or a usual one both rise. */
+  score: number;
+};
+
+export function useCategoryActivity(month: string, previousMonths: number) {
+  const first = monthUtils.subMonths(month, previousMonths);
+  const { data } = useQuery({
+    queryKey: ['upside', 'category-activity', month, previousMonths],
+    queryFn: async () => {
+      const { data: rows } = await aqlQuery(
+        q('transactions')
+          .filter({
+            date: {
+              $gte: monthUtils.firstDayOfMonth(first),
+              $lte: monthUtils.lastDayOfMonth(month),
+            },
+            category: { $ne: null },
+            'account.offbudget': false,
+          })
+          .options({ splits: 'inline' })
+          .groupBy(['category', { $month: '$date' }])
+          .select([
+            'category',
+            { month: { $month: '$date' } },
+            { amount: { $sum: '$amount' } },
+          ]),
+      );
+      return rows as Array<{ category: string; month: string; amount: number }>;
+    },
+    refetchOnMount: 'always',
+    refetchOnWindowFocus: true,
+  });
+
+  const rows = data ?? [];
+  // Only count months that have any activity at all (a brand-new budget
+  // shouldn't average over empty months).
+  const activeMonths = new Set(rows.filter(r => r.month !== month).map(r => r.month));
+  const divisor = Math.max(1, Math.min(previousMonths, activeMonths.size));
+
+  const result = new Map<string, CategoryActivity>();
+  for (const row of rows) {
+    const spent = -row.amount;
+    const entry = result.get(row.category) ?? { thisMonth: 0, average: 0, score: 0 };
+    if (row.month === month) {
+      entry.thisMonth += spent;
+    } else {
+      entry.average += spent / divisor;
+    }
+    result.set(row.category, entry);
+  }
+  for (const entry of result.values()) {
+    entry.thisMonth = Math.max(0, entry.thisMonth);
+    entry.average = Math.max(0, Math.round(entry.average));
+    entry.score = Math.max(entry.thisMonth, entry.average);
+  }
+  return { activity: result, isLoaded: data != null };
+}
diff --git a/packages/desktop-client/src/components/mobile/upside/useBankConnection.ts b/packages/desktop-client/src/components/mobile/upside/useBankConnection.ts
new file mode 100644
index 0000000..9363b44
--- /dev/null
+++ b/packages/desktop-client/src/components/mobile/upside/useBankConnection.ts
@@ -0,0 +1,184 @@
+import { useEffect, useState } from 'react';
+
+import { send } from '@actual-app/core/platform/client/connection';
+import type { SyncServerSimpleFinAccount } from '@actual-app/core/types/models/simplefin';
+
+import {
+  useLinkAccountSimpleFinMutation,
+  useSyncAndDownloadMutation,
+} from '#accounts';
+import { useAccounts } from '#hooks/useAccounts';
+import { useSimpleFinStatus } from '#hooks/useSimpleFinStatus';
+import { useSyncedPref } from '#hooks/useSyncedPref';
+import { useSyncServerStatus } from '#hooks/useSyncServerStatus';
+import { pushModal } from '#modals/modalsSlice';
+import { useDispatch } from '#redux';
+
+// Upside's bank connection: one SimpleFIN token covers every bank either of
+// you links at SimpleFIN. Every account found there is added automatically
+// (no per-account setup), and bank sync then runs on its own.
+
+export const SIMPLEFIN_URL = 'https://beta-bridge.simplefin.org/';
+
+// Automatic sync every 4 hours while the app is open, plus whenever it's
+// opened and that much time has passed.
+const DEFAULT_SYNC_MINUTES = '240';
+
+type RawSimpleFinAccount = {
+  id: string;
+  name: string;
+  balance: number;
+  org: { name: string; domain: string; id: string };
+};
+
+export type BankConnectionState =
+  | 'needs-server'
+  | 'loading'
+  | 'needs-token'
+  | 'connected';
+
+export function useBankConnection() {
+  const dispatch = useDispatch();
+  const serverStatus = useSyncServerStatus();
+  const { simpleFinStatus, setSimpleFinStatus, isLoading } =
+    useSimpleFinStatus();
+  const { data: localAccounts = [] } = useAccounts();
+  const linkAccount = useLinkAccountSimpleFinMutation();
+  const syncAndDownload = useSyncAndDownloadMutation();
+  const [syncInterval, setSyncInterval] = useSyncedPref('bank-sync-interval');
+
+  const [newAccounts, setNewAccounts] = useState<SyncServerSimpleFinAccount[]>([]);
+  const [isAdding, setIsAdding] = useState(false);
+  const [lastAdded, setLastAdded] = useState<number | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  const state: BankConnectionState =
+    serverStatus === 'no-server'
+      ? 'needs-server'
+      : isLoading || serverStatus !== 'online'
+        ? 'loading'
+        : simpleFinStatus.configured
+          ? 'connected'
+          : 'needs-token';
+
+  const hasLinkedAccounts = localAccounts.some(
+    a => a.closed === 0 && a.account_sync_source === 'simpleFin',
+  );
+
+  // Make sure automatic sync is on once any bank is linked.
+  useEffect(() => {
+    if (hasLinkedAccounts && !syncInterval) {
+      setSyncInterval(DEFAULT_SYNC_MINUTES);
+    }
+  }, [hasLinkedAccounts, syncInterval, setSyncInterval]);
+
+  async function fetchUnlinked(): Promise<SyncServerSimpleFinAccount[] | null> {
+    const results = await send('simplefin-accounts');
+    if (results.error_code === 'INVALID_ACCESS_TOKEN') {
+      setSimpleFinStatus({ ...simpleFinStatus, configured: false });
+      return null;
+    }
+    if (results.error_code || ('error' in results && results.error)) {
+      throw new Error(
+        results.reason || results.error_code || String(results.error),
+      );
+    }
+    const linked = new Set(
+      localAccounts.filter(a => a.closed === 0).map(a => a.account_id),
+    );
+    return ((results.accounts ?? []) as RawSimpleFinAccount[])
+      .filter(a => !linked.has(a.id))
+      .map(a => ({
+        account_id: a.id,
+        name: a.name,
+        institution: a.org.name,
+        orgDomain: a.org.domain,
+        orgId: a.org.id,
+        balance: a.balance,
+      }));
+  }
+
+  // Look for accounts added at SimpleFIN since last time (e.g. your partner
+  // linked her bank there).
+  const localKey = localAccounts.map(a => `${a.id}:${a.account_id}`).join(',');
+  useEffect(() => {
+    if (state !== 'connected') return;
+    let cancelled = false;
+    fetchUnlinked()
+      .then(found => {
+        if (!cancelled && found) setNewAccounts(found);
+      })
+      .catch(() => {});
+    return () => {
+      cancelled = true;
+    };
+    // fetchUnlinked reads the same inputs captured by these keys
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [state, localKey]);
+
+  async function addAllNew() {
+    setIsAdding(true);
+    setError(null);
+    try {
+      const found = (await fetchUnlinked()) ?? [];
+      for (const externalAccount of found) {
+        await linkAccount.mutateAsync({ externalAccount, offBudget: false });
+      }
+      setNewAccounts([]);
+      setLastAdded(found.length);
+      if (!syncInterval) setSyncInterval(DEFAULT_SYNC_MINUTES);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+    } finally {
+      setIsAdding(false);
+    }
+  }
+
+  /** Paste a SimpleFIN setup token, then add every account it can see. */
+  function connect() {
+    if (state === 'connected') {
+      void addAllNew();
+      return;
+    }
+    dispatch(
+      pushModal({
+        modal: {
+          name: 'simplefin-init',
+          options: {
+            credentialSource: simpleFinStatus.source ?? 'global',
+            onSuccess: perBudgetFile => {
+              setSimpleFinStatus({
+                configured: true,
+                source: perBudgetFile ? 'per-budget-file' : 'global',
+              });
+              void addAllNew();
+            },
+          },
+        },
+      }),
+    );
+  }
+
+  function openSimpleFin() {
+    window.Actual.openURLInBrowser(SIMPLEFIN_URL);
+  }
+
+  function addManually() {
+    dispatch(pushModal({ modal: { name: 'add-local-account' } }));
+  }
+
+  return {
+    state,
+    hasLinkedAccounts,
+    newAccounts,
+    isAdding,
+    lastAdded,
+    error,
+    isSyncing: syncAndDownload.isPending,
+    connect,
+    addAllNew,
+    openSimpleFin,
+    addManually,
+    syncNow: () => syncAndDownload.mutateAsync({}),
+  };
+}
