diff --git a/packages/desktop-client/src/components/mobile/upside/people.ts b/packages/desktop-client/src/components/mobile/upside/people.ts
new file mode 100644
index 0000000..f5d6fec
--- /dev/null
+++ b/packages/desktop-client/src/components/mobile/upside/people.ts
@@ -0,0 +1,186 @@
+import { useQuery } from '@tanstack/react-query';
+
+import * as monthUtils from '@actual-app/core/shared/months';
+import { q } from '@actual-app/core/shared/query';
+import type { AccountEntity } from '@actual-app/core/types/models';
+import type { SyncedPrefs } from '@actual-app/core/types/prefs';
+
+import { saveSyncedPrefs } from '#prefs/prefsSlice';
+import { aqlQuery } from '#queries/aqlQuery';
+import { useDispatch, useSelector } from '#redux';
+
+// Upside's "people": the two of you plus "Shared". Names and each account's
+// owner are stored as synced budget prefs, so whatever one phone sets shows
+// up on the other.
+
+export type PersonId = 'p1' | 'p2';
+export type OwnerId = PersonId | 'shared';
+export type OwnerKey = OwnerId | 'unassigned';
+
+export type Person = { id: PersonId; name: string };
+
+// Upside's own synced prefs. They aren't in Actual's SyncedPrefs type list
+// (changing that type loosens Actual's API types), so cast at the edges.
+type PrefKey = keyof SyncedPrefs;
+export const PEOPLE_PREF = 'upside-people' as PrefKey;
+export function ownerPref(accountId: string) {
+  return `upside-owner-${accountId}` as PrefKey;
+}
+function savePrefs(prefs: Record<string, string>) {
+  return saveSyncedPrefs({ prefs: prefs as SyncedPrefs });
+}
+
+// Fixed per-person colors, readable in both light and dark mode.
+export const OWNER_COLORS: Record<OwnerKey, string> = {
+  p1: '#0a84ff',
+  p2: '#ff9f0a',
+  shared: '#8e8e93',
+  unassigned: '#c7c7cc',
+};
+export const OWNER_INK: Record<OwnerKey, string> = {
+  p1: '#ffffff',
+  p2: '#1a1100',
+  shared: '#ffffff',
+  unassigned: '#1c1c1e',
+};
+
+function parsePeople(raw: string | undefined): Person[] {
+  if (!raw) return [];
+  try {
+    const parsed = JSON.parse(raw) as Partial<Record<PersonId, string>>;
+    return (['p1', 'p2'] as const)
+      .map(id => ({ id, name: (parsed[id] ?? '').trim() }))
+      .filter(p => p.name.length > 0);
+  } catch {
+    return [];
+  }
+}
+
+export function initialOf(name: string) {
+  return (name.trim()[0] ?? '?').toUpperCase();
+}
+
+export function usePeople() {
+  const dispatch = useDispatch();
+  const raw = useSelector(state => state.prefs.synced[PEOPLE_PREF]);
+  const people = parsePeople(raw);
+
+  function setNames(p1: string, p2: string) {
+    void dispatch(
+      savePrefs({
+        [PEOPLE_PREF]: JSON.stringify({ p1: p1.trim(), p2: p2.trim() }),
+      }),
+    );
+  }
+
+  function nameOf(owner: OwnerKey): string {
+    if (owner === 'shared') return 'Shared';
+    if (owner === 'unassigned') return 'Not set';
+    return people.find(p => p.id === owner)?.name ?? (owner === 'p1' ? 'Person 1' : 'Person 2');
+  }
+
+  return { people, isSetUp: people.length > 0, setNames, nameOf };
+}
+
+/**
+ * Guess an owner from the bank's account name: "Ron's Chase" belongs to
+ * Ron, "Joint Checking" is Shared. Returns null when there's no clue.
+ */
+export function guessOwner(
+  account: Pick<AccountEntity, 'name'> & { official_name?: string | null },
+  people: Person[],
+): OwnerId | null {
+  const text = `${account.name} ${account.official_name ?? ''}`.toLowerCase();
+  if (/\b(joint|shared|household|family|bills)\b/.test(text)) return 'shared';
+  for (const person of people) {
+    const first = person.name.toLowerCase().split(/\s+/)[0];
+    if (first && first.length >= 2 && new RegExp(`\\b${escapeRegExp(first)}`).test(text)) {
+      return person.id;
+    }
+  }
+  return null;
+}
+
+function escapeRegExp(s: string) {
+  return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+}
+
+export function useAccountOwners() {
+  const dispatch = useDispatch();
+  const synced = useSelector(state => state.prefs.synced);
+  const { people } = usePeople();
+
+  /** The saved owner if someone picked one, else a guess from the name. */
+  function ownerOf(account: AccountEntity): { owner: OwnerKey; isGuess: boolean } {
+    const saved = synced[ownerPref(account.id)];
+    if (saved === 'p1' || saved === 'p2' || saved === 'shared') {
+      return { owner: saved, isGuess: false };
+    }
+    const guess = guessOwner(account, people);
+    return guess ? { owner: guess, isGuess: true } : { owner: 'unassigned', isGuess: false };
+  }
+
+  function setOwner(accountId: string, owner: OwnerId) {
+    void dispatch(savePrefs({ [ownerPref(accountId)]: owner }));
+  }
+
+  return { ownerOf, setOwner };
+}
+
+export type SpendingByOwner = Record<string, Partial<Record<OwnerKey, number>>>;
+
+/**
+ * This month's spending per category, split by who owns the account it came
+ * from. Amounts are positive cents (refunds reduce them).
+ */
+export function useSpendingByOwner(
+  month: string,
+  accounts: AccountEntity[],
+  ownerOf: (a: AccountEntity) => { owner: OwnerKey },
+  // Only spending categories count; income (paychecks) would otherwise
+  // make the account owner's spending look negative.
+  expenseCategoryIds: Set<string>,
+) {
+  const { data } = useQuery({
+    queryKey: ['upside', 'spending-by-account', month],
+    queryFn: async () => {
+      const { data: rows } = await aqlQuery(
+        q('transactions')
+          .filter({
+            date: {
+              $gte: monthUtils.firstDayOfMonth(month),
+              $lte: monthUtils.lastDayOfMonth(month),
+            },
+            category: { $ne: null },
+          })
+          .options({ splits: 'inline' })
+          .groupBy(['category', 'account'])
+          .select(['category', 'account', { amount: { $sum: '$amount' } }]),
+      );
+      return rows as Array<{ category: string; account: string; amount: number }>;
+    },
+    refetchOnMount: 'always',
+    refetchOnWindowFocus: true,
+  });
+
+  const byId = new Map(accounts.map(a => [a.id, a]));
+  const result: SpendingByOwner = {};
+  const total: Partial<Record<OwnerKey, number>> = {};
+  for (const row of data ?? []) {
+    const account = byId.get(row.account);
+    if (!account || account.offbudget === 1) continue;
+    if (!expenseCategoryIds.has(row.category)) continue;
+    const owner = ownerOf(account).owner;
+    const spent = -row.amount;
+    const forCategory = (result[row.category] ??= {});
+    forCategory[owner] = (forCategory[owner] ?? 0) + spent;
+    total[owner] = (total[owner] ?? 0) + spent;
+  }
+  // Net refunds can push a person's total below zero; show zero instead.
+  for (const key of Object.keys(total) as OwnerKey[]) {
+    total[key] = Math.max(0, total[key] ?? 0);
+  }
+  return { byCategory: result, total };
+}
+
+export const OWNER_ORDER: OwnerKey[] = ['p1', 'p2', 'shared', 'unassigned'];
