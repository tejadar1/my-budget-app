+import { useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { theme } from '@actual-app/components/theme';
+
+import { OWNER_COLORS, OWNER_INK, initialOf } from './people';
+import type { Person } from './people';
+
+// "Who's budgeting?" — each of you types your own name once. Saved on the
+// budget, so it shows up on both phones.
+
+export function PeopleSetup({
+  people,
+  onSave,
+  onCancel,
+}: {
+  people: Person[];
+  onSave: (p1: string, p2: string) => void;
+  onCancel?: () => void;
+}) {
+  const { t } = useTranslation();
+  const [p1, setP1] = useState(people.find(p => p.id === 'p1')?.name ?? '');
+  const [p2, setP2] = useState(people.find(p => p.id === 'p2')?.name ?? '');
+  const canSave = p1.trim().length > 0;
+
+  const input = (
+    id: 'p1' | 'p2',
+    label: string,
+    value: string,
+    onChange: (v: string) => void,
+  ) => (
+    <label
+      htmlFor={`upside-${id}`}
+      style={{ display: 'flex', alignItems: 'center', gap: 12 }}
+    >
+      <span
+        aria-hidden="true"
+        style={{
+          width: 36,
+          height: 36,
+          flexShrink: 0,
+          borderRadius: 18,
+          background: OWNER_COLORS[id],
+          color: OWNER_INK[id],
+          display: 'flex',
+          alignItems: 'center',
+          justifyContent: 'center',
+          fontWeight: 700,
+        }}
+      >
+        {value.trim() ? initialOf(value) : id === 'p1' ? '1' : '2'}
+      </span>
+      <span style={{ display: 'flex', flexDirection: 'column', gap: 4, flex: 1 }}>
+        <span style={{ fontSize: 13, color: theme.pageTextSubdued }}>{label}</span>
+        <input
+          id={`upside-${id}`}
+          value={value}
+          onChange={e => onChange(e.target.value)}
+          autoComplete="given-name"
+          autoCapitalize="words"
+          style={{
+            font: 'inherit',
+            fontSize: 17,
+            padding: '10px 12px',
+            borderRadius: 10,
+            border: `1px solid ${theme.formInputBorder}`,
+            background: theme.formInputBackground,
+            color: theme.formInputText,
+            outline: 'none',
+          }}
+        />
+      </span>
+    </label>
+  );
+
+  return (
+    <div
+      style={{
+        borderRadius: 22,
+        padding: 20,
+        background: theme.cardBackground,
+        display: 'flex',
+        flexDirection: 'column',
+        gap: 16,
+      }}
+    >
+      <div style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
+        <span style={{ fontSize: 20, fontWeight: 800, color: theme.pageText }}>
+          {t('Who’s budgeting?')}
+        </span>
+        <span style={{ fontSize: 14, color: theme.pageTextSubdued }}>
+          {t(
+            'Type your names so Upside can show who spent what. Accounts are matched to you by name when the bank includes it.',
+          )}
+        </span>
+      </div>
+      {input('p1', t('Your name'), p1, setP1)}
+      {input('p2', t('Partner’s name'), p2, setP2)}
+      <div style={{ display: 'flex', gap: 10, justifyContent: 'flex-end' }}>
+        {onCancel && (
+          <button
+            type="button"
+            onClick={onCancel}
+            style={{
+              all: 'unset',
+              minHeight: 44,
+              padding: '0 16px',
+              color: theme.pageTextSubdued,
+              fontSize: 17,
+              cursor: 'pointer',
+            }}
+          >
+            {t('Cancel')}
+          </button>
+        )}
+        <button
+          type="button"
+          disabled={!canSave}
+          onClick={() => onSave(p1, p2)}
+          style={{
+            all: 'unset',
+            minHeight: 44,
+            padding: '0 22px',
+            borderRadius: 12,
+            background: theme.buttonPrimaryBackground,
+            color: theme.buttonPrimaryText,
+            fontSize: 17,
+            fontWeight: 700,
+            display: 'flex',
+            alignItems: 'center',
+            cursor: canSave ? 'pointer' : 'default',
+            opacity: canSave ? 1 : 0.5,
+          }}
+        >
+          {t('Save')}
+        </button>
+      </div>
+    </div>
+  );
+}
+
+export function Avatars({
+  people,
+  onPress,
+}: {
+  people: Person[];
+  onPress: () => void;
+}) {
+  const { t } = useTranslation();
+  return (
+    <button
+      type="button"
+      aria-label={t('Edit names')}
+      onClick={onPress}
+      style={{
+        all: 'unset',
+        display: 'flex',
+        alignItems: 'center',
+        minHeight: 44,
+        cursor: 'pointer',
+      }}
+    >
+      {people.map((p, i) => (
+        <span
+          key={p.id}
+          style={{
+            width: 34,
+            height: 34,
+            borderRadius: 17,
+            marginLeft: i === 0 ? 0 : -8,
+            background: OWNER_COLORS[p.id],
+            color: OWNER_INK[p.id],
+            border: `2px solid ${theme.mobilePageBackground}`,
+            display: 'flex',
+            alignItems: 'center',
+            justifyContent: 'center',
+            fontSize: 14,
+            fontWeight: 700,
+          }}
+        >
+          {initialOf(p.name)}
+        </span>
+      ))}
+    </button>
+  );
+}
diff --git a/packages/desktop-client/src/components/mobile/upside/UpsideAccountsPage.tsx b/packages/desktop-client/src/components/mobile/upside/UpsideAccountsPage.tsx
