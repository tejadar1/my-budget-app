@@ -0,0 +1,460 @@
+import { useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Link, Navigate, useLocation } from 'react-router';
+
+import { theme } from '@actual-app/components/theme';
+import type { AccountEntity } from '@actual-app/core/types/models';
+
+import { useSyncAndDownloadMutation } from '#accounts';
+import { ALL_ACCOUNTS_ID } from '#components/mobile/accounts/AccountsPage';
+import { MOBILE_NAV_HEIGHT } from '#components/mobile/MobileNavTabs';
+import { PullToRefresh } from '#components/mobile/PullToRefresh';
+import { Page } from '#components/Page';
+import { useAccounts } from '#hooks/useAccounts';
+import { useFormat } from '#hooks/useFormat';
+import { useSheetValue } from '#hooks/useSheetValue';
+import { replaceModal } from '#modals/modalsSlice';
+import { useDispatch } from '#redux';
+import * as bindings from '#spreadsheet/bindings';
+
+import {
+  OWNER_COLORS,
+  OWNER_INK,
+  initialOf,
+  useAccountOwners,
+  usePeople,
+} from './people';
+import type { OwnerId, OwnerKey } from './people';
+
+// Wallet-style accounts: each account is a colored card with its owner
+// (you, your partner or Shared). New accounts nobody has claimed yet are
+// listed first with a quick "whose is this?" picker.
+
+const CARD_GRADIENTS = [
+  'linear-gradient(135deg, #1d4ed8 0%, #1e3a8a 100%)',
+  'linear-gradient(135deg, #b91c1c 0%, #7f1d1d 100%)',
+  'linear-gradient(135deg, #7e22ce 0%, #3b0764 100%)',
+  'linear-gradient(135deg, #15803d 0%, #052e16 100%)',
+  'linear-gradient(135deg, #a16207 0%, #422006 100%)',
+  'linear-gradient(135deg, #0f766e 0%, #042f2e 100%)',
+  'linear-gradient(135deg, #be185d 0%, #500724 100%)',
+  'linear-gradient(135deg, #334155 0%, #0f172a 100%)',
+];
+
+function gradientFor(account: AccountEntity) {
+  const key = account.bankName ?? account.name;
+  let hash = 0;
+  for (let i = 0; i < key.length; i++) {
+    hash = (hash * 31 + key.charCodeAt(i)) >>> 0;
+  }
+  return CARD_GRADIENTS[hash % CARD_GRADIENTS.length];
+}
+
+export function UpsideAccountsPage() {
+  const { t } = useTranslation();
+  const format = useFormat();
+  const dispatch = useDispatch();
+  const { data: accounts = [] } = useAccounts();
+  const { ownerOf, setOwner } = useAccountOwners();
+  const { people, isSetUp } = usePeople();
+  const syncAndDownload = useSyncAndDownloadMutation();
+  const [openId, setOpenId] = useState<string | null>(null);
+  const netWorth = useSheetValue<'account', 'accounts-balance'>(bindings.allAccountBalance()) ?? 0;
+  const location = useLocation();
+
+  const open = accounts.filter(a => a.closed === 0);
+  const unclaimed = open.filter(a => ownerOf(a).owner === 'unassigned');
+
+  // Report drill-downs land on /accounts with filters; show them as
+  // filtered transactions, like Actual does.
+  const filterConditions = location?.state?.filterConditions || [];
+  if (filterConditions.length > 0) {
+    return (
+      <Navigate to={`/accounts/${ALL_ACCOUNTS_ID}`} state={location.state} replace />
+    );
+  }
+
+  return (
+    <Page header={null} padding={0}>
+      <PullToRefresh onRefresh={async () => syncAndDownload.mutate({})}>
+        <div
+          style={{
+            display: 'flex',
+            flexDirection: 'column',
+            gap: 24,
+            padding: '0 16px',
+            paddingTop: 'calc(env(safe-area-inset-top) + 18px)',
+            paddingBottom: `calc(env(safe-area-inset-bottom) + ${MOBILE_NAV_HEIGHT + 24}px)`,
+          }}
+        >
+          <header style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
+            <span
+              style={{
+                fontSize: 13,
+                fontWeight: 600,
+                letterSpacing: 0.6,
+                color: theme.pageTextSubdued,
+              }}
+            >
+              {t('{{count}} ACCOUNTS · PULL DOWN TO SYNC', { count: open.length })}
+            </span>
+            <h1
+              style={{
+                margin: 0,
+                fontSize: 34,
+                fontWeight: 800,
+                letterSpacing: -0.6,
+                color: theme.pageText,
+              }}
+            >
+              {t('Accounts')}
+            </h1>
+          </header>
+
+          <div style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
+            <span style={{ fontSize: 13, color: theme.pageTextSubdued }}>
+              {t('Net worth across everything')}
+            </span>
+            <span
+              style={{
+                fontSize: 40,
+                fontWeight: 800,
+                letterSpacing: -1,
+                color: netWorth < 0 ? theme.numberNegative : theme.pageTextPositive,
+              }}
+            >
+              {format(netWorth, 'financial-no-decimals')}
+            </span>
+          </div>
+
+          {isSetUp && unclaimed.length > 0 && (
+            <section
+              aria-label={t('Whose accounts are these?')}
+              style={{
+                borderRadius: 18,
+                background: theme.cardBackground,
+                padding: 16,
+                display: 'flex',
+                flexDirection: 'column',
+                gap: 14,
+              }}
+            >
+              <div style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
+                <span style={{ fontSize: 17, fontWeight: 700, color: theme.pageText }}>
+                  {t('Whose accounts are these?')}
+                </span>
+                <span style={{ fontSize: 13, color: theme.pageTextSubdued }}>
+                  {t('This decides how spending shows up in who spent what.')}
+                </span>
+              </div>
+              {unclaimed.map(account => (
+                <div
+                  key={account.id}
+                  style={{ display: 'flex', flexDirection: 'column', gap: 8 }}
+                >
+                  <span style={{ fontSize: 15, fontWeight: 600, color: theme.pageText }}>
+                    {account.name}
+                  </span>
+                  <OwnerPicker
+                    value={null}
+                    people={people.map(p => ({ id: p.id, name: p.name }))}
+                    onChange={owner => setOwner(account.id, owner)}
+                  />
+                </div>
+              ))}
+            </section>
+          )}
+
+          {!isSetUp && (
+            <Link
+              to="/budget"
+              style={{
+                borderRadius: 18,
+                background: theme.cardBackground,
+                padding: 16,
+                color: theme.pageText,
+                textDecoration: 'none',
+                fontSize: 15,
+              }}
+            >
+              {t('Add your names on the Budget tab to tag each account as yours, your partner’s or shared.')}
+            </Link>
+          )}
+
+          <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
+            {open.map(account => (
+              <AccountCard
+                key={account.id}
+                account={account}
+                owner={ownerOf(account).owner}
+                isOpen={openId === account.id}
+                onToggle={() => setOpenId(openId === account.id ? null : account.id)}
+                people={people.map(p => ({ id: p.id, name: p.name }))}
+                onChangeOwner={owner => setOwner(account.id, owner)}
+              />
+            ))}
+          </div>
+
+          <button
+            type="button"
+            onClick={() =>
+              dispatch(replaceModal({ modal: { name: 'add-account', options: {} } }))
+            }
+            style={{
+              all: 'unset',
+              alignSelf: 'center',
+              minHeight: 44,
+              padding: '0 20px',
+              borderRadius: 22,
+              border: `1px solid ${theme.tableBorder}`,
+              color: theme.pageTextPositive,
+              fontSize: 15,
+              fontWeight: 600,
+              display: 'flex',
+              alignItems: 'center',
+              cursor: 'pointer',
+            }}
+          >
+            {t('Connect a bank')}
+          </button>
+        </div>
+      </PullToRefresh>
+    </Page>
+  );
+}
+
+function AccountCard({
+  account,
+  owner,
+  isOpen,
+  onToggle,
+  people,
+  onChangeOwner,
+}: {
+  account: AccountEntity;
+  owner: OwnerKey;
+  isOpen: boolean;
+  onToggle: () => void;
+  people: Array<{ id: 'p1' | 'p2'; name: string }>;
+  onChangeOwner: (owner: OwnerId) => void;
+}) {
+  const { t } = useTranslation();
+  const format = useFormat();
+  const balance = useSheetValue<'account', 'balance'>(bindings.accountBalance(account.id)) ?? 0;
+  const ownerName =
+    owner === 'shared'
+      ? t('Shared')
+      : owner === 'unassigned'
+        ? t('Not set')
+        : (people.find(p => p.id === owner)?.name ?? '');
+  const isCredit = balance < 0;
+  const subtitle = [
+    account.bankName,
+    account.offbudget === 1 ? t('Off budget') : null,
+    account.mask ? `•• ${account.mask}` : null,
+  ]
+    .filter(Boolean)
+    .join(' · ');
+
+  return (
+    <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
+      <button
+        type="button"
+        aria-expanded={isOpen}
+        onClick={onToggle}
+        style={{
+          all: 'unset',
+          boxSizing: 'border-box',
+          cursor: 'pointer',
+          minHeight: 150,
+          borderRadius: 18,
+          padding: '16px 18px',
+          background: gradientFor(account),
+          color: '#ffffff',
+          display: 'flex',
+          flexDirection: 'column',
+          justifyContent: 'space-between',
+          gap: 18,
+          boxShadow: '0 6px 18px rgba(0,0,0,0.18)',
+          WebkitTapHighlightColor: 'transparent',
+        }}
+      >
+        <div
+          style={{
+            display: 'flex',
+            justifyContent: 'space-between',
+            alignItems: 'flex-start',
+            gap: 10,
+          }}
+        >
+          <div style={{ display: 'flex', flexDirection: 'column', gap: 2, minWidth: 0 }}>
+            <span
+              style={{
+                fontSize: 17,
+                fontWeight: 700,
+                overflow: 'hidden',
+                textOverflow: 'ellipsis',
+                whiteSpace: 'nowrap',
+              }}
+            >
+              {account.name}
+            </span>
+            {subtitle && (
+              <span style={{ fontSize: 12, color: 'rgba(255,255,255,0.85)' }}>
+                {subtitle}
+              </span>
+            )}
+          </div>
+          <span
+            style={{
+              display: 'flex',
+              alignItems: 'center',
+              gap: 6,
+              flexShrink: 0,
+              padding: '4px 10px 4px 4px',
+              borderRadius: 14,
+              background: 'rgba(0,0,0,0.35)',
+              fontSize: 12,
+              fontWeight: 600,
+            }}
+          >
+            <span
+              style={{
+                width: 20,
+                height: 20,
+                borderRadius: 10,
+                background: OWNER_COLORS[owner],
+                color: OWNER_INK[owner],
+                display: 'flex',
+                alignItems: 'center',
+                justifyContent: 'center',
+                fontSize: 11,
+                fontWeight: 800,
+              }}
+            >
+              {owner === 'shared' ? 'S' : owner === 'unassigned' ? '?' : initialOf(ownerName)}
+            </span>
+            {ownerName}
+          </span>
+        </div>
+        <div style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
+          <span style={{ fontSize: 12, color: 'rgba(255,255,255,0.85)' }}>
+            {isCredit ? t('Owed') : t('Balance')}
+          </span>
+          <span style={{ fontSize: 28, fontWeight: 800, letterSpacing: -0.5 }}>
+            {format(Math.abs(balance), 'financial')}
+          </span>
+        </div>
+      </button>
+
+      {isOpen && (
+        <div
+          style={{
+            borderRadius: 18,
+            background: theme.cardBackground,
+            padding: 14,
+            display: 'flex',
+            flexDirection: 'column',
+            gap: 12,
+          }}
+        >
+          <span style={{ fontSize: 13, color: theme.pageTextSubdued }}>
+            {t('Whose account is this?')}
+          </span>
+          <OwnerPicker
+            value={owner === 'unassigned' ? null : owner}
+            people={people}
+            onChange={onChangeOwner}
+          />
+          <Link
+            to={`/accounts/${account.id}`}
+            style={{
+              minHeight: 44,
+              display: 'flex',
+              alignItems: 'center',
+              justifyContent: 'center',
+              color: theme.pageTextPositive,
+              fontSize: 15,
+              fontWeight: 600,
+              textDecoration: 'none',
+            }}
+          >
+            {t('See transactions')}
+          </Link>
+        </div>
+      )}
+    </div>
+  );
+}
+
+function OwnerPicker({
+  value,
+  people,
+  onChange,
+}: {
+  value: OwnerId | null;
+  people: Array<{ id: 'p1' | 'p2'; name: string }>;
+  onChange: (owner: OwnerId) => void;
+}) {
+  const { t } = useTranslation();
+  const options: Array<{ id: OwnerId; label: string }> = [
+    ...people.map(p => ({ id: p.id, label: p.name })),
+    { id: 'shared', label: t('Shared') },
+  ];
+  return (
+    <div
+      role="radiogroup"
+      style={{
+        display: 'grid',
+        gridTemplateColumns: `repeat(${options.length}, minmax(0, 1fr))`,
+        gap: 4,
+        padding: 3,
+        borderRadius: 12,
+        background: theme.tableBorder,
+      }}
+    >
+      {options.map(option => {
+        const selected = value === option.id;
+        return (
+          <button
+            key={option.id}
+            type="button"
+            role="radio"
+            aria-checked={selected}
+            onClick={() => onChange(option.id)}
+            style={{
+              all: 'unset',
+              minHeight: 36,
+              borderRadius: 9,
+              display: 'flex',
+              alignItems: 'center',
+              justifyContent: 'center',
+              gap: 6,
+              fontSize: 14,
+              fontWeight: 600,
+              cursor: 'pointer',
+              background: selected ? theme.cardBackground : 'transparent',
+              color: theme.pageText,
+              boxShadow: selected ? '0 1px 3px rgba(0,0,0,0.15)' : 'none',
+              overflow: 'hidden',
+            }}
+          >
+            <span
+              aria-hidden="true"
+              style={{
+                width: 8,
+                height: 8,
+                borderRadius: 4,
+                flexShrink: 0,
+                background: OWNER_COLORS[option.id],
+              }}
+            />
+            <span style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
+              {option.label}
+            </span>
+          </button>
+        );
+      })}
+    </div>
+  );
+}
