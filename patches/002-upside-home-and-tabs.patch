+import { useEffect, useState } from 'react';
+import type { CSSProperties, ReactNode } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Link } from 'react-router';
+
+import { theme } from '@actual-app/components/theme';
+import * as monthUtils from '@actual-app/core/shared/months';
+import type { CategoryEntity } from '@actual-app/core/types/models';
+import { useQuery } from '@tanstack/react-query';
+
+import { budgetBoundsQueries } from '#budget';
+import { prewarmMonth } from '#components/budget/util';
+import { MOBILE_NAV_HEIGHT } from '#components/mobile/MobileNavTabs';
+import { Page } from '#components/Page';
+import { useCategories } from '#hooks/useCategories';
+import { useFormat } from '#hooks/useFormat';
+import { useLocale } from '#hooks/useLocale';
+import { useNavigate } from '#hooks/useNavigate';
+import { SheetNameProvider } from '#hooks/useSheetName';
+import { useSheetValue } from '#hooks/useSheetValue';
+import { useSpreadsheet } from '#hooks/useSpreadsheet';
+import { useSyncedPref } from '#hooks/useSyncedPref';
+import type { SheetFields } from '#spreadsheet';
+
+// Upside's home screen: one big "money left this month" answer, then a card
+// per category with its limit, what's left and the 3-month average.
+// Works on both budget types; Upside is meant to run on "tracking".
+
+type Field = SheetFields<'tracking-budget'>;
+
+const AVERAGE_MONTHS = 3;
+
+// Brand constants that stay the same in light and dark mode, like the
+// mockups' green summary card.
+const HERO_GRADIENT = 'linear-gradient(150deg, #15803d 0%, #0e5a2b 55%, #052e16 100%)';
+const WARNING = '#f59e0b';
+
+function field(name: string) {
+  return name as Field;
+}
+
+/** A value from a specific month's sheet, e.g. ('budget202609', 'total-spent'). */
+function useMonthValue(sheet: string, name: string): number | null {
+  const spreadsheet = useSpreadsheet();
+  const [value, setValue] = useState<number | null>(null);
+  useEffect(() => {
+    let isMounted = true;
+    const binding = { name } as Parameters<typeof spreadsheet.bind>[1];
+    const unbind = spreadsheet.bind(sheet, binding, result => {
+      if (isMounted) {
+        setValue(typeof result.value === 'number' ? result.value : null);
+      }
+    });
+    return () => {
+      isMounted = false;
+      unbind();
+    };
+  }, [spreadsheet, sheet, name]);
+  return value;
+}
+
+function usePreviousMonths(month: string) {
+  const { data: bounds } = useQuery(budgetBoundsQueries.bounds());
+  const months = Array.from({ length: AVERAGE_MONTHS }, (_, i) =>
+    monthUtils.subMonths(month, i + 1),
+  );
+  // Months before the budget's first month have no data; don't let them
+  // drag the average down.
+  const valid = months.map(m => (bounds ? m >= bounds.start : false));
+  return { months, valid };
+}
+
+function average(values: Array<number | null>, valid: boolean[]) {
+  const used = values
+    .map((v, i) => (valid[i] && v != null ? Math.abs(v) : null))
+    .filter((v): v is number => v != null);
+  if (used.length === 0) return null;
+  return Math.round(used.reduce((a, b) => a + b, 0) / used.length);
+}
+
+function daysLeftInMonth() {
+  const now = new Date();
+  const last = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
+  return last - now.getDate();
+}
+
+
+export function UpsideBudgetPage() {
+  const { t } = useTranslation();
+  const locale = useLocale();
+  const spreadsheet = useSpreadsheet();
+  const [budgetTypePref] = useSyncedPref('budgetType');
+  const budgetType = budgetTypePref === 'tracking' ? 'tracking' : 'envelope';
+  const month = monthUtils.currentMonth();
+  const { months: previous } = usePreviousMonths(month);
+  const { data: { grouped: groups } = { grouped: [] } } = useCategories();
+
+  useEffect(() => {
+    for (const m of [month, ...previous]) {
+      void prewarmMonth(budgetType, spreadsheet, m).catch(() => {});
+    }
+    // previous is derived from month
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [budgetType, spreadsheet, month]);
+
+  const expenseGroups = groups
+    .filter(g => !g.is_income && !g.hidden)
+    .map(g => ({
+      ...g,
+      categories: (g.categories ?? []).filter(c => !c.hidden),
+    }))
+    .filter(g => g.categories.length > 0);
+
+  return (
+    <Page header={null} padding={0}>
+      <SheetNameProvider name={monthUtils.sheetForMonth(month)}>
+        <div
+          style={{
+            display: 'flex',
+            flexDirection: 'column',
+            gap: 28,
+            padding: '0 16px',
+            paddingTop: 'calc(env(safe-area-inset-top) + 18px)',
+            paddingBottom: `calc(env(safe-area-inset-bottom) + ${MOBILE_NAV_HEIGHT + 24}px)`,
+          }}
+        >
+          <header
+            style={{
+              display: 'flex',
+              justifyContent: 'space-between',
+              alignItems: 'flex-end',
+            }}
+          >
+            <div style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
+              <span
+                style={{
+                  fontSize: 13,
+                  fontWeight: 600,
+                  letterSpacing: 0.6,
+                  textTransform: 'uppercase',
+                  color: theme.pageTextSubdued,
+                }}
+              >
+                {monthUtils.format(month, 'MMMM yyyy', locale)}
+              </span>
+              <h1
+                style={{
+                  margin: 0,
+                  fontSize: 34,
+                  fontWeight: 800,
+                  letterSpacing: -0.6,
+                  color: theme.pageText,
+                }}
+              >
+                {t('Budget')}
+              </h1>
+            </div>
+            <Link
+              to="/budget/limits"
+              style={{
+                minHeight: 44,
+                display: 'flex',
+                alignItems: 'center',
+                fontSize: 17,
+                color: theme.pageTextPositive,
+                textDecoration: 'none',
+              }}
+            >
+              {t('Edit limits')}
+            </Link>
+          </header>
+
+          <MonthSummary month={month} />
+
+          {expenseGroups.map(group => (
+            <section
+              key={group.id}
+              style={{ display: 'flex', flexDirection: 'column', gap: 12 }}
+            >
+              <h2
+                style={{
+                  margin: 0,
+                  fontSize: 22,
+                  fontWeight: 700,
+                  letterSpacing: -0.3,
+                  color: theme.pageText,
+                }}
+              >
+                {group.name}
+              </h2>
+              <div
+                style={{
+                  display: 'grid',
+                  gridTemplateColumns: 'repeat(2, minmax(0, 1fr))',
+                  gap: 12,
+                }}
+              >
+                {group.categories.map(category => (
+                  <CategoryCard
+                    key={category.id}
+                    category={category}
+                    month={month}
+                  />
+                ))}
+              </div>
+            </section>
+          ))}
+        </div>
+      </SheetNameProvider>
+    </Page>
+  );
+}
+
+function MonthSummary({ month }: { month: string }) {
+  const { t } = useTranslation();
+  const format = useFormat();
+  const { months, valid } = usePreviousMonths(month);
+
+  const budgeted = Math.abs(useSheetValue<'tracking-budget', Field>('total-budgeted') ?? 0);
+  const spent = Math.abs(useSheetValue<'tracking-budget', Field>('total-spent') ?? 0);
+  const prev0 = useMonthValue(monthUtils.sheetForMonth(months[0]), 'total-spent');
+  const prev1 = useMonthValue(monthUtils.sheetForMonth(months[1]), 'total-spent');
+  const prev2 = useMonthValue(monthUtils.sheetForMonth(months[2]), 'total-spent');
+  const avg = average([prev0, prev1, prev2], valid);
+
+  const left = budgeted - spent;
+  const isOver = left < 0;
+  const daysLeft = daysLeftInMonth();
+  const usedPct = budgeted > 0 ? Math.min(100, (spent / budgeted) * 100) : 0;
+  const avgPct =
+    avg != null && budgeted > 0 ? Math.min(100, (avg / budgeted) * 100) : null;
+  const money = (v: number) => format(Math.abs(v), 'financial-no-decimals');
+
+  return (
+    <div
+      style={{
+        borderRadius: 22,
+        padding: 22,
+        background: HERO_GRADIENT,
+        color: '#ffffff',
+        display: 'flex',
+        flexDirection: 'column',
+        gap: 14,
+      }}
+    >
+      <span
+        style={{
+          fontSize: 13,
+          fontWeight: 700,
+          letterSpacing: 0.6,
+          color: 'rgba(255,255,255,0.82)',
+        }}
+      >
+        {t('THIS MONTH')}
+      </span>
+      <div style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
+        <span
+          style={{
+            fontSize: 44,
+            fontWeight: 800,
+            letterSpacing: -1,
+            lineHeight: 1,
+          }}
+        >
+          {isOver
+            ? t('{{amount}} over', { amount: money(left) })
+            : t('{{amount}} left', { amount: money(left) })}
+        </span>
+        <span style={{ fontSize: 15, color: 'rgba(255,255,255,0.86)' }}>
+          {budgeted > 0
+            ? t('of {{limit}} · {{when}}', {
+                limit: money(budgeted),
+                when: daysLeft === 0
+                  ? t('last day of the month')
+                  : daysLeft === 1
+                    ? t('1 day to go')
+                    : t('{{days}} days to go', { days: daysLeft }),
+              })
+            : t('Set limits to see what’s left')}
+        </span>
+        {avg != null && (
+          <span style={{ fontSize: 13, color: 'rgba(255,255,255,0.86)' }}>
+            {t('Your average month: {{amount}}', { amount: money(avg) })}
+          </span>
+        )}
+      </div>
+      <Bar
+        percent={usedPct}
+        fill={isOver ? '#ff6961' : '#ffffff'}
+        track="rgba(0,0,0,0.3)"
+        height={10}
+        marker={avgPct}
+        markerColor="#ffffff"
+        markerLabel={t('avg')}
+      />
+    </div>
+  );
+}
+
+function CategoryCard({
+  category,
+  month,
+}: {
+  category: CategoryEntity;
+  month: string;
+}) {
+  const { t } = useTranslation();
+  const format = useFormat();
+  const navigate = useNavigate();
+  const { months, valid } = usePreviousMonths(month);
+
+  const budgeted = Math.abs(
+    useSheetValue<'tracking-budget', Field>(field(`budget-${category.id}`)) ?? 0,
+  );
+  const spent = Math.abs(
+    useSheetValue<'tracking-budget', Field>(field(`sum-amount-${category.id}`)) ?? 0,
+  );
+  const balance =
+    useSheetValue<'tracking-budget', Field>(field(`leftover-${category.id}`)) ??
+    budgeted - spent;
+  const prev0 = useMonthValue(monthUtils.sheetForMonth(months[0]), `sum-amount-${category.id}`);
+  const prev1 = useMonthValue(monthUtils.sheetForMonth(months[1]), `sum-amount-${category.id}`);
+  const prev2 = useMonthValue(monthUtils.sheetForMonth(months[2]), `sum-amount-${category.id}`);
+  const avg = average([prev0, prev1, prev2], valid);
+
+  const hasLimit = budgeted > 0;
+  const isOver = balance < 0;
+  const isLow = hasLimit && !isOver && balance < budgeted * 0.15;
+  const amountColor = isOver
+    ? theme.numberNegative
+    : isLow
+      ? WARNING
+      : theme.pageTextPositive;
+  const money = (v: number) => format(Math.abs(v), 'financial-no-decimals');
+
+  let headline: ReactNode;
+  let detail: string;
+  if (!hasLimit) {
+    headline = money(spent);
+    detail = t('spent · no limit');
+  } else if (isOver) {
+    headline = t('{{amount}} over', { amount: money(balance) });
+    detail = t('limit {{limit}}', { limit: money(budgeted) });
+  } else {
+    headline = money(balance);
+    detail = t('left of {{limit}}', { limit: money(budgeted) });
+  }
+
+  const cardStyle: CSSProperties = {
+    all: 'unset',
+    boxSizing: 'border-box',
+    cursor: 'pointer',
+    borderRadius: 18,
+    padding: 16,
+    background: theme.cardBackground,
+    display: 'flex',
+    flexDirection: 'column',
+    gap: 10,
+    minWidth: 0,
+    WebkitTapHighlightColor: 'transparent',
+  };
+
+  return (
+    <button
+      type="button"
+      style={cardStyle}
+      onClick={() => void navigate(`/categories/${category.id}?month=${month}`)}
+    >
+      <span
+        style={{
+          fontSize: 15,
+          fontWeight: 600,
+          color: theme.pageText,
+          overflow: 'hidden',
+          textOverflow: 'ellipsis',
+          whiteSpace: 'nowrap',
+        }}
+      >
+        {category.name}
+      </span>
+      <div style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
+        <span
+          style={{
+            fontSize: 24,
+            fontWeight: 800,
+            letterSpacing: -0.4,
+            color: hasLimit ? amountColor : theme.pageText,
+          }}
+        >
+          {headline}
+        </span>
+        <span style={{ fontSize: 12, color: theme.pageTextSubdued }}>{detail}</span>
+        {avg != null && (
+          <span style={{ fontSize: 12, color: theme.pageTextSubdued }}>
+            {t('avg {{amount}}/mo', { amount: money(avg) })}
+          </span>
+        )}
+      </div>
+      {hasLimit && (
+        <Bar
+          percent={Math.min(100, (spent / budgeted) * 100)}
+          fill={isOver ? theme.numberNegative : amountColor}
+          track={theme.tableBorder}
+          height={6}
+          marker={avg != null ? Math.min(100, (avg / budgeted) * 100) : null}
+          markerColor={theme.pageText}
+        />
+      )}
+    </button>
+  );
+}
+
+function Bar({
+  percent,
+  fill,
+  track,
+  height,
+  marker,
+  markerColor,
+  markerLabel,
+}: {
+  percent: number;
+  fill: string;
+  track: string;
+  height: number;
+  marker: number | null;
+  markerColor: string;
+  markerLabel?: string;
+}) {
+  return (
+    <div
+      style={{
+        position: 'relative',
+        paddingTop: markerLabel && marker != null ? 18 : 0,
+      }}
+    >
+      {markerLabel && marker != null && (
+        <span
+          style={{
+            position: 'absolute',
+            top: 0,
+            left: `${marker}%`,
+            transform: 'translateX(-50%)',
+            fontSize: 11,
+            fontWeight: 600,
+            whiteSpace: 'nowrap',
+          }}
+        >
+          {markerLabel}
+        </span>
+      )}
+      <div
+        style={{
+          height,
+          borderRadius: height / 2,
+          background: track,
+          overflow: 'hidden',
+        }}
+      >
+        <div
+          style={{
+            width: `${percent}%`,
+            height: '100%',
+            borderRadius: height / 2,
+            background: fill,
+          }}
+        />
+      </div>
+      {marker != null && (
+        <span
+          aria-hidden="true"
+          style={{
+            position: 'absolute',
+            left: `${marker}%`,
+            bottom: -3,
+            width: 2,
+            height: height + 6,
+            marginLeft: -1,
+            borderRadius: 1,
+            background: markerColor,
+          }}
+        />
+      )}
+    </div>
+  );
+}
